                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Search Box -->
                                    <RowDefinition Height="*"/>    <!-- Pool List -->
                                    <RowDefinition Height="Auto"/> <!-- Add Buttons -->
                                    <RowDefinition Height="Auto"/> <!-- Exit / Reset -->
                                </Grid.RowDefinitions>
                                
                                <!-- Search Box -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBox Name="PoolSearchBox" Height="26" Padding="5,2" 
                                               Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}" BorderThickness="1" 
                                               VerticalContentAlignment="Center" FontSize="11"/>
                                    <TextBlock IsHitTestVisible="False" Text="Search pool..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource CustomizerSecText}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PoolSearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                
                                <!-- Pool TreeView -->
                                <TreeView Grid.Row="1" Name="PoolTreeView" Background="Transparent" BorderThickness="0"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"
                                          HorizontalContentAlignment="Stretch" AllowDrop="True"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                            <Setter Property="IsExpanded" Value="True"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,1,0,1"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TreeViewItem">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto" Name="ItemsHostRow"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <!-- Header border containing the item row -->
                                                            <Border x:Name="ItemBd" CornerRadius="4" Background="{TemplateBinding Background}" Padding="6,4"
                                                                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/> <!-- Expander Toggle -->
                                                                        <ColumnDefinition Width="*"/>    <!-- Content -->
                                                                    </Grid.ColumnDefinitions>
                                                                    
                                                                    <!-- Expander Toggle Button -->
                                                                    <ToggleButton x:Name="Expander" ClickMode="Press" Margin="0,0,4,0"
                                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                                        <ToggleButton.Style>
                                                                            <Style TargetType="ToggleButton">
                                                                                <Setter Property="UIElement.Focusable" Value="False"/>
                                                                                <Setter Property="FrameworkElement.Width" Value="14"/>
                                                                                <Setter Property="FrameworkElement.Height" Value="14"/>
                                                                                <Setter Property="Control.Template">
                                                                                    <Setter.Value>
                                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                                            <Border Width="14" Height="14" Background="Transparent">
                                                                                                <Path x:Name="ExpandPath" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                                      Fill="{DynamicResource CustomizerSecText}"
                                                                                                      Data="M 4 2 L 8 6 L 4 10 Z"/>
                                                                                            </Border>
                                                                                            <ControlTemplate.Triggers>
                                                                                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                                                                                    <Setter TargetName="ExpandPath" Property="Path.Data" Value="M 2 4 L 10 4 L 6 8 Z"/>
                                                                                                </Trigger>
                                                                                            </ControlTemplate.Triggers>
                                                                                        </ControlTemplate>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </Style>
                                                                        </ToggleButton.Style>
                                                                    </ToggleButton>
                                                                    
                                                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" ContentStringFormat="{TemplateBinding HeaderStringFormat}" HorizontalAlignment="Stretch"/>
                                                                </Grid>
                                                            </Border>
                                                            
                                                            <ItemsPresenter Grid.Row="1" Name="ItemsHost" Margin="12,0,0,0"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="TreeViewItem.IsExpanded" Value="False">
                                                                <Setter TargetName="ItemsHost" Property="UIElement.Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                            <Trigger Property="TreeViewItem.HasItems" Value="False">
                                                                <Setter TargetName="Expander" Property="UIElement.Visibility" Value="Hidden"/>
                                                            </Trigger>
                                                            <Trigger Property="UIElement.IsMouseOver" Value="True" SourceName="ItemBd">
                                                                <Setter TargetName="ItemBd" Property="Panel.Background" Value="#15FFFFFF"/>
                                                            </Trigger>
                                                            <Trigger Property="TreeViewItem.IsSelected" Value="True">
                                                                <Setter TargetName="ItemBd" Property="Panel.Background" Value="#2500E5FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding children}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                                    <ColumnDefinition Width="22"/>   <!-- Icon -->
                                                    <ColumnDefinition Width="*"/>    <!-- Name -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Level -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Priority -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Eye (Visibility) -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Delete -->
                                                </Grid.ColumnDefinitions>
                                                
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="on_pool_item_checked_changed" Unchecked="on_pool_item_checked_changed" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                
                                                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" Name="ItemIconImage" Visibility="Collapsed"/>
                                                    <TextBlock Text="{Binding Icon}" FontSize="12" Name="ItemIconText" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CustomizerText}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ContextSummary}" FontSize="9" Foreground="{DynamicResource CustomizerSecText}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding LevelLabel}" FontSize="9" Foreground="{DynamicResource CustomizerSecText}" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                                <TextBlock Grid.Column="4" Text="{Binding PriorityLabel}" FontSize="9" Foreground="{DynamicResource CustomizerHighlight}" VerticalAlignment="Center" FontWeight="Bold" MinWidth="20" TextAlignment="Right"/>
                                                
                                                <Button Grid.Column="5" Name="BtnRowEye" Width="20" Height="20" Margin="6,0,0,0"
                                                         Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                                         ToolTip="{Binding EyeToolTip}">
                                                     <Button.Template>
                                                         <ControlTemplate TargetType="Button">
                                                             <Border Background="{TemplateBinding Background}">
                                                                 <Path Data="{Binding EyeGeometry}"
                                                                       Fill="{Binding EyeBrush}" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                             </Border>
                                                         </ControlTemplate>
                                                     </Button.Template>
                                                 </Button>
                                                
                                                <Button Grid.Column="6" Name="BtnRowDelete" Width="20" Height="20" Margin="6,0,0,0"
                                                         Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center"
                                                         ToolTip="Delete from pool">
                                                     <Button.Template>
                                                         <ControlTemplate TargetType="Button">
                                                             <Border Background="{TemplateBinding Background}">
                                                                 <Path Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2,-0.9,2,-2V7H6V19z M19,4h-3.5l-1,-1h-5l-1,1H5v2h14V4z"
                                                                       Fill="#FFE53935" Stretch="Uniform" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                             </Border>
                                                         </ControlTemplate>
                                                     </Button.Template>
                                                 </Button>
                                            </Grid>
                                            <HierarchicalDataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsImageIcon}" Value="True">
                                                    <Setter TargetName="ItemIconImage" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ItemIconText" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsImageIcon}" Value="False">
                                                    <Setter TargetName="ItemIconImage" Property="Visibility" Value="Collapsed"/>
                                                    <Setter TargetName="ItemIconText" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </HierarchicalDataTemplate.Triggers>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                
                                <!-- Drag Preview Popup -->
                                <Popup Name="DragPreviewPopup" AllowsTransparency="True" IsOpen="False" Placement="Relative" PlacementTarget="{Binding ElementName=PoolTreeView}" IsHitTestVisible="False">
                                    <Border CornerRadius="4" Background="#E0222222" BorderBrush="#FF00E5FF" BorderThickness="1.5" Padding="8,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Name="DragPreviewIconImage" Width="16" Height="16" Margin="0,0,6,0" Visibility="Collapsed"/>
                                            <TextBlock Name="DragPreviewIconText" Foreground="White" FontSize="11" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                                            <TextBlock Name="DragPreviewText" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                
                                <!-- Add Buttons -->
                                <Grid Grid.Row="2" Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Name="BtnAddFromPyRevit" Grid.Column="0" Content="＋ New" Height="24" Margin="0,0,3,0"
                                            Background="#FF4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="9">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Name="BtnAddSubmenuPool" Grid.Column="1" Content="＋ Submenu" Height="24" Margin="3,0,3,0"
                                            Background="#FF9C27B0" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="9">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Name="BtnAddEmptyPool" Grid.Column="2" Content="＋ Empty" Height="24" Margin="3,0,0,0"
                                            Background="#FF78909C" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="9">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                
                                <!-- Exit / Reset -->
                                <StackPanel Grid.Row="3" Margin="0,2,0,0">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Name="BtnDeleteChecked" Grid.Column="0" Content="Delete Checked" Height="24" Margin="0,0,4,0"
                                                Background="#FFE53935" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Name="BtnExitCustomizer" Grid.Column="1" Content="Exit Settings" Height="24" Margin="4,0,0,0"
                                                Background="#FF55555C" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Right Column: Edit Panel (shown when a pool item is selected) -->
                            <Border Grid.Column="1" Name="PoolEditPlaceholder" Visibility="Visible" Width="285"
                                    CornerRadius="6" Background="{DynamicResource CustomizerPanelBg}" Padding="8" Margin="10,0,0,0" VerticalAlignment="Stretch">
                                <Grid>
                                    <TextBlock Text="Select a command from the list&#x0a;to configure its context rules." 
                                               Foreground="{DynamicResource CustomizerSecText}" FontSize="11" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" LineHeight="16"/>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Name="PoolEditPanel" Visibility="Collapsed" IsEnabled="True" Width="285"
                                    CornerRadius="6" Background="{DynamicResource CustomizerPanelBg}" Padding="8" Margin="10,0,0,0" VerticalAlignment="Stretch">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Title -->
                                        <RowDefinition Height="Auto"/> <!-- Static Input Fields -->
                                        <RowDefinition Height="*"/>    <!-- Scrollable Class List -->
                                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Name="TxtEditItemName" Text="Edit: Command Name" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource CustomizerText}" Margin="0,0,0,6"/>
                                    
                                    <!-- Command details fields -->
                                    <StackPanel Grid.Row="1" Margin="0,0,0,4">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Name:" Foreground="{DynamicResource CustomizerSecText}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBox Name="EditItemNameTxt" Grid.Column="1" Height="22" FontSize="10" Padding="4,1" VerticalContentAlignment="Center"
                                                     Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Command:" Foreground="{DynamicResource CustomizerSecText}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBox Name="EditItemCommandTxt" Grid.Column="1" Height="22" FontSize="10" Padding="4,1" VerticalContentAlignment="Center"
                                                     Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}"/>
                                        </Grid>
                                        
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Icon/Emoji:" Foreground="{DynamicResource CustomizerSecText}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBox Name="EditItemIconTxt" Grid.Column="1" Height="22" FontSize="10" Padding="4,1" VerticalContentAlignment="Center"
                                                     Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}"/>
                                            <Button Name="BtnSelectIcon" Grid.Column="2" Content="🔍" Width="22" Height="22" Margin="3,0,0,0"
                                                    Background="#FF55555C" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10" ToolTip="Select from parsed icons">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                        
                                        <!-- View type checkboxes -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <CheckBox Name="EditChkView3D" Content="3D" Foreground="{DynamicResource CustomizerText}" FontSize="10" Margin="0,0,12,0"/>
                                            <CheckBox Name="EditChkViewPlan" Content="Plans" Foreground="{DynamicResource CustomizerText}" FontSize="10" Margin="0,0,12,0"/>
                                            <CheckBox Name="EditChkViewSheet" Content="Sheets" Foreground="{DynamicResource CustomizerText}" FontSize="10"/>
                                        </StackPanel>
                                        
                                        <!-- Selection context checkboxes -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <CheckBox Name="EditChkPrehighlighted" Content="Pre-highlighted" Foreground="{DynamicResource CustomizerText}" FontSize="10" Margin="0,0,12,0"/>
                                            <CheckBox Name="EditChkSelection" Content="Selection" Foreground="{DynamicResource CustomizerText}" FontSize="10"/>
                                        </StackPanel>
                                        
                                        <!-- Class/Category search -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBox Name="EditClassSearch" Height="20" FontSize="10" Padding="4,1"
                                                     Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" 
                                                     BorderBrush="{DynamicResource CustomizerSecText}" VerticalContentAlignment="Center"/>
                                            <TextBlock IsHitTestVisible="False" Text="Search classes/categories..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0" Foreground="{DynamicResource CustomizerSecText}" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=EditClassSearch}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <ListBox Grid.Row="2" Name="EditClassList" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,2,0,6"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                                             VirtualizingStackPanel.IsVirtualizingWhenGrouping="True">
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <ScrollViewer Background="Transparent" Focusable="False">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="{DynamicResource CustomizerText}" FontSize="10" Margin="1" Style="{x:Null}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="GroupItem">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="GroupItem">
                                                                    <StackPanel>
                                                                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                                        <ItemsPresenter Margin="10,0,0,0" />
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource CustomizerBorderBrush}" BorderThickness="0,0,0,1" Margin="0,4,0,2" Padding="0,2,0,4">
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource CustomizerSecText}" FontWeight="Bold" FontSize="10" />
                                                        </Border>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                    </ListBox>
                                    
                                    <!-- Action buttons -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Name="BtnPoolItemSave" Grid.Column="0" Content="Save" Height="22" Margin="0,0,3,0"
                                                Background="#FF0083B0" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Name="BtnPoolItemCancel" Grid.Column="1" Content="Cancel" Height="22" Margin="3,0,0,0"
                                                Background="#FF55555C" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    
                    <!-- Tab 1: Appearance Settings -->
                    <TabItem>
                        <Grid Margin="0,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <ScrollViewer Grid.Row="0" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Height="425">
                                <StackPanel Margin="0,0,10,0">
                                    <!-- ComboBox: Trigger Mode -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Trigger Mode:" Foreground="{DynamicResource CustomizerSecText}" FontSize="11" VerticalAlignment="Center"/>
                                        <ComboBox Name="TriggerModeComboBox" Grid.Column="1" Height="24" FontSize="11" VerticalContentAlignment="Center" Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}">
                                            <ComboBoxItem Content="Right Hold"/>
                                            <ComboBoxItem Content="Right Double Click"/>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Slider: Hold Delay -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Hold Delay:" Foreground="{DynamicResource CustomizerSecText}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Name="DelaySlider" Grid.Column="1" Minimum="200" Maximum="1000" Value="400" IsSnapToTickEnabled="True" TickFrequency="50" VerticalAlignment="Center"/>
                                        <TextBlock Name="DelayValueText" Grid.Column="2" Text="400 ms" Foreground="{DynamicResource CustomizerHighlight}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <!-- Slider: Core Radius -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Core Radius:" Foreground="{DynamicResource CustomizerSecText}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Name="CoreRadiusSlider" Grid.Column="1" Minimum="30" Maximum="70" Value="45" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                                        <TextBlock Name="CoreRadiusValueText" Grid.Column="2" Text="45 px" Foreground="{DynamicResource CustomizerHighlight}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <!-- Slider: Petal Width -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Petal Width:" Foreground="{DynamicResource CustomizerSecText}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Name="PetalWidthSlider" Grid.Column="1" Minimum="35" Maximum="90" Value="60" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                                        <TextBlock Name="PetalWidthValueText" Grid.Column="2" Text="60 px" Foreground="{DynamicResource CustomizerHighlight}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <!-- Slider: Ring Spacing -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Ring Spacing:" Foreground="{DynamicResource CustomizerSecText}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Name="RingSpacingSlider" Grid.Column="1" Minimum="0" Maximum="15" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"/>
                                        <TextBlock Name="RingSpacingValueText" Grid.Column="2" Text="5 px" Foreground="{DynamicResource CustomizerHighlight}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <!-- Slider: Sector Spacing -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Sector Spacing:" Foreground="{DynamicResource CustomizerSecText}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Name="SectorSpacingSlider" Grid.Column="1" Minimum="0" Maximum="10" Value="3" IsSnapToTickEnabled="True" TickFrequency="0.5" VerticalAlignment="Center"/>
                                        <TextBlock Name="SectorSpacingValueText" Grid.Column="2" Text="3.0 px" Foreground="{DynamicResource CustomizerHighlight}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <!-- Divider -->
                                    <Border BorderBrush="{DynamicResource CustomizerBorderBrush}" BorderThickness="0,0,0,1" Margin="0,5,0,10"/>
                                    
                                    <!-- Slider: L2 Max Petal Angle -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="L2 Max Angle:" Foreground="{DynamicResource CustomizerSecText}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Name="L2MaxAngleSlider" Grid.Column="1" Minimum="30" Maximum="180" Value="90" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"/>
                                        <TextBlock Name="L2MaxAngleValueText" Grid.Column="2" Text="90°" Foreground="{DynamicResource CustomizerHighlight}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <!-- Slider: L3 Max Petal Angle -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="L3 Max Angle:" Foreground="{DynamicResource CustomizerSecText}" FontSize="11" VerticalAlignment="Center"/>
                                        <Slider Name="L3MaxAngleSlider" Grid.Column="1" Minimum="30" Maximum="180" Value="90" IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"/>
                                        <TextBlock Name="L3MaxAngleValueText" Grid.Column="2" Text="90°" Foreground="{DynamicResource CustomizerHighlight}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <!-- Divider -->
                                    <Border BorderBrush="{DynamicResource CustomizerBorderBrush}" BorderThickness="0,0,0,1" Margin="0,5,0,10"/>
                                    
                                    <!-- Theme Presets Dropdown -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Theme Preset:" Foreground="{DynamicResource CustomizerSecText}" FontSize="11" VerticalAlignment="Center"/>
                                        <ComboBox Name="ThemeComboBox" Grid.Column="1" Height="24" FontSize="11" VerticalContentAlignment="Center" Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}">
                                            <ComboBoxItem Content="Revit Theme (Auto)"/>
                                            <ComboBoxItem Content="pyRevit Dark"/>
                                            <ComboBoxItem Content="Neon Fusion"/>
                                            <ComboBoxItem Content="Classic Blue"/>
                                            <ComboBoxItem Content="Forest Green"/>
                                            <ComboBoxItem Content="Cyberpunk"/>
                                            <ComboBoxItem Content="Custom Theme"/>
                                        </ComboBox>
                                    </Grid>
                                    
                                    <!-- Custom Color Hex Inputs -->
                                    <TextBlock Text="Custom Hex Colors (e.g. #AARRGGBB)" Foreground="{DynamicResource CustomizerSecText}" FontSize="10.5" FontWeight="Bold" Margin="0,5,0,8"/>
                                    
                                    <!-- Normal Fill -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Normal Fill:" Foreground="{DynamicResource CustomizerSecText}" FontSize="10.5" VerticalAlignment="Center"/>
                                        <TextBox Name="HexNormalText" Grid.Column="1" Height="22" Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}" FontSize="11" VerticalContentAlignment="Center"/>
                                    </Grid>
                                    
                                    <!-- Hover Start Fill -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Hover Start:" Foreground="{DynamicResource CustomizerSecText}" FontSize="10.5" VerticalAlignment="Center"/>
                                        <TextBox Name="HexHoverStartText" Grid.Column="1" Height="22" Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}" FontSize="11" VerticalContentAlignment="Center"/>
                                    </Grid>
                                    
                                    <!-- Hover End Fill -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Hover End:" Foreground="{DynamicResource CustomizerSecText}" FontSize="10.5" VerticalAlignment="Center"/>
                                        <TextBox Name="HexHoverEndText" Grid.Column="1" Height="22" Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}" FontSize="11" VerticalContentAlignment="Center"/>
                                    </Grid>
                                    
                                    <!-- Border Fill -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Border:" Foreground="{DynamicResource CustomizerSecText}" FontSize="10.5" VerticalAlignment="Center"/>
                                        <TextBox Name="HexBorderText" Grid.Column="1" Height="22" Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}" FontSize="11" VerticalContentAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                            
                            <!-- Exit Settings and Extract Icons Buttons -->
                            <Grid Grid.Row="1" Margin="0,12,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Name="BtnExtractAllIcons" Grid.Column="0" Content="Extract Ribbon Icons" Height="24" Margin="0,0,5,0"
                                        Background="#FF0083B0" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Name="BtnExitCustomizerLook" Grid.Column="1" Content="Exit Settings" Height="24" Margin="5,0,0,0"
                                        Background="#FF55555C" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>
                    
                    <!-- Hidden legacy tab placeholders to keep XAML name references valid -->
                    <!-- Tab 2: PyRevit Command Picker (shown as dialog) -->
                    <TabItem>
                        <Grid Margin="0,5,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Search -->
                                <RowDefinition Height="*"/>    <!-- TreeView -->
                                <RowDefinition Height="Auto"/> <!-- Add button -->
                            </Grid.RowDefinitions>
                            
                            <!-- Search Box for pyRevit commands -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBox Name="SearchBox" Height="26" Padding="5,2" 
                                           Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}" BorderThickness="1" 
                                           VerticalContentAlignment="Center" FontSize="11"/>
                                <TextBlock IsHitTestVisible="False" Text="Search commands (pyRevit &amp; Revit Ribbon)..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource CustomizerSecText}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            
                            <!-- Commands TreeView -->
                            <TreeView Name="CommandTreeView" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource CustomizerText}"/>
                                        <Setter Property="Padding" Value="2"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition/>
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <ToggleButton x:Name="Expander" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                                    <ToggleButton.Style>
                                                                        <Style TargetType="ToggleButton">
                                                                            <Setter Property="UIElement.Focusable" Value="false"/>
                                                                            <Setter Property="Width" Value="12"/>
                                                                            <Setter Property="Height" Value="12"/>
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                                        <Border Background="Transparent" Width="12" Height="12">
                                                                                            <Path x:Name="Arrow" Fill="{DynamicResource CustomizerSecText}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0,0 L 4,4 L 0,8 Z"/>
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                                                                    <Setter.Value>
                                                                                                        <RotateTransform Angle="90" CenterX="2" CenterY="4"/>
                                                                                                    </Setter.Value>
                                                                                                </Setter>
                                                                                            </Trigger>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource CustomizerText}"/>
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </Style>
                                                                    </ToggleButton.Style>
                                                                </ToggleButton>
                                                                <ContentPresenter x:Name="PART_Header" Grid.Column="1" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" ContentStringFormat="{TemplateBinding HeaderStringFormat}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="14,0,0,0"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="HasItems" Value="False">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="IsExpanded" Value="False">
                                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True" SourceName="Bd">
                                                            <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#3000E5FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid Margin="2" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="4" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Grid>
                                                    <Image Source="{Binding IconPath}" Width="16" Height="16" Stretch="Uniform" Visibility="Collapsed" Name="NodeImage"/>
                                                    <TextBlock Text="📁" FontSize="11" Foreground="{DynamicResource CustomizerSecText}" VerticalAlignment="Center" HorizontalAlignment="Center" Name="NodeFolder"/>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource CustomizerText}" FontWeight="SemiBold"/>
                                        </Grid>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCommand}" Value="True">
                                                <Setter TargetName="NodeFolder" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="NodeImage" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPulldown}" Value="True">
                                                <Setter TargetName="NodeFolder" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="NodeImage" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IconPath}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding IsCommand}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="NodeFolder" Property="Text" Value="📄"/>
                                                <Setter TargetName="NodeFolder" Property="Foreground" Value="{DynamicResource CustomizerSecText}"/>
                                                <Setter TargetName="NodeFolder" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IconPath}" Value="{x:Null}"/>
                                                    <Condition Binding="{Binding IsPulldown}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="NodeFolder" Property="Text" Value="📁"/>
                                                <Setter TargetName="NodeFolder" Property="Foreground" Value="{DynamicResource CustomizerHighlight}"/>
                                                <Setter TargetName="NodeFolder" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            
                            <!-- Picker buttons -->
                            <Grid Grid.Row="2" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Button Name="BtnPickerAddCommand" Grid.Column="0" Content="Add Selected Command to Pool" Height="26" Margin="0,0,5,0"
                                        Background="#FF4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                
                                <Button Name="BtnPickerCancel" Grid.Column="1" Content="Cancel" Height="26"
                                        Background="#FF757575" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
                
                <!-- Icon Picker Overlay -->
                <Grid Name="IconPickerOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#F5202026" Visibility="Collapsed" Margin="-15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header / Title -->
                        <RowDefinition Height="Auto"/> <!-- Search Box -->
                        <RowDefinition Height="*"/>    <!-- Icons Grid List -->
                        <RowDefinition Height="Auto"/> <!-- Buttons -->
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#1AFFFFFF" Padding="15,10">
                        <TextBlock Text="Select Built-in Icon" Foreground="{DynamicResource CustomizerText}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    
                    <!-- Search Box -->
                    <Grid Grid.Row="1" Margin="15,10,15,10">
                        <TextBox Name="IconPickerSearchBox" Height="26" Padding="5,2" 
                                 Background="{DynamicResource CustomizerInputBg}" Foreground="{DynamicResource CustomizerInputText}" BorderBrush="{DynamicResource CustomizerSecText}" BorderThickness="1" 
                                 VerticalContentAlignment="Center" FontSize="11"/>
                        <TextBlock IsHitTestVisible="False" Text="Search icons..." VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource CustomizerSecText}" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=IconPickerSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <!-- Icons ListBox (with WrapPanel to display a grid of icons) -->
                    <ListBox Name="IconPickerListBox" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="15,0,15,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Margin="0" Orientation="Horizontal" IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="2"/>
                                <Setter Property="Width" Value="58"/>
                                <Setter Property="Height" Value="58"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="Transparent" Padding="4">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#15FFFFFF"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#30FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#2500E5FF"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF00E5FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Name}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Image Source="{Binding FullPath}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0"/>
                                    <TextBlock Text="{Binding CleanName}" FontSize="8" Foreground="{DynamicResource CustomizerSecText}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Grid.Row="1" Width="50" Margin="0,2,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- Footer Buttons -->
                    <Border Grid.Row="3" Background="#10FFFFFF" Padding="15,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Name="BtnIconPickerSelect" Grid.Column="0" Content="Select" Height="26" Margin="0,0,5,0"
                                    Background="#FF0083B0" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="Bold">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Name="BtnIconPickerCancel" Grid.Column="1" Content="Cancel" Height="26" Margin="5,0,0,0"
                                    Background="#FF55555C" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="11">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="4" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
