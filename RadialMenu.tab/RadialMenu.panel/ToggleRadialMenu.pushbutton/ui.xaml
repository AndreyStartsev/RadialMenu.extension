        <Border Name="CustomizerBorder" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                Margin="10" Padding="15" CornerRadius="15" Background="{DynamicResource CustomizerBg}" BorderBrush="{DynamicResource CustomizerBorderBrush}" BorderThickness="1.2" Visibility="Collapsed"
                UseLayoutRounding="True"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType"
                RenderOptions.ClearTypeHint="Enabled">

            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="*"/>    <!-- TabControl -->
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Name="TxtPanelTitle" Text="Commands &amp; Structure" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CustomizerText}" Margin="0,0,0,10" HorizontalAlignment="Center" Cursor="SizeAll"/>
                
                <TabControl Name="CustomizerTabControl" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0">
                    <TabControl.Resources>
                        <!-- Hide TabItem Headers entirely for a cleaner segmented UI controlled by the core -->
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Style>
                    </TabControl.Resources>
                    
                    <!-- Tab 0: Command Pool -->
                    <TabItem>
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Column: Command List & Controls -->
