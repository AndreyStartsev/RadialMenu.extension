                        </Grid>
                        <Border Name="BtnL1_1LabelBorder" Style="{StaticResource LabelBorderStyle}">
                            <TextBlock Name="BtnL1_1Label" Text="" Style="{StaticResource LabelTextStyle}"/>
                        </Border>
                        <TextBlock Name="BtnL1_1Arrow" Text="▼" FontSize="7" Foreground="#80FFFFFF" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
